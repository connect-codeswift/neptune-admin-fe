# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js generated route/cache types (regenerated on dev/build)
/types/

# Everyone keeps their own agent instruction files locally — not shared via git.
/AGENTS.md
/CLAUDE.md
/.docs/
/.cursor/
/.claude/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Other agents' local config — same rule as AGENTS.md/CLAUDE.md above, kept per-developer.
/GEMINI.md
/.gemini/
/.mcp.json
/opencode.json
/.ignore

# eslint --cache writes this; it is per-machine state, never shared.
.eslintcache

# Editor config is per-developer, not shared.
.vscode/
