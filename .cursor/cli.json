{
  "permissions": {
    "allow": [
      "Shell(npm)",
      "Shell(npx)",
      "Shell(node)",
      "Shell(eslint)",
      "Shell(next)",
      "Read(src/**)",
      "Read(public/**)",
      "Read(*.json)",
      "Read(*.md)",
      "Read(*.mjs)",
      "Read(*.ts)",
      "Write(src/**)",
      "Write(public/**)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "WebFetch(cursor.com)",
      "WebFetch(nextjs.org)",
      "WebFetch(github.com)",
      "WebFetch(*.githubusercontent.com)"
    ],
    "deny": ["Read(.env*)", "Write(.env*)", "Write(**/.env*)"]
  }
}
